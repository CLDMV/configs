# CLDMV base Prettier ignore list (@cldmv/configs/prettierignore).
# Copy this file to .prettierignore, or pass it with --ignore-path, and add the
# repository's own paths below the marker line at the end.

# Dependencies
node_modules/

# Build and test output, not hand-authored
dist/
build/
coverage/

# Scratch and discarded work
tmp/
trash/

# Lockfiles are generated by the package manager
package-lock.json
pnpm-lock.yaml

# Minified or compact generated files of any extension (*.min.js, *.min.css, *.min.json, ...)
*.min.*

# YAML: CI workflow files are deliberately 4-space indented, and YAML forbids tabs, so
# Prettier at tabWidth 2 would reindent every workflow for no gain
*.yml
*.yaml

# --- repository-specific paths below this line ---
