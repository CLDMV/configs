{
	"name": "@cldmv/configs",
	"version": "1.4.0",
	"description": "CLDMV's shared tool configurations (ESLint, Prettier, Vitest, fix-headers) that CLDMV repos extend.",
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"bin": {
		"cldmv-configs": "bin/cldmv-configs.mjs"
	},
	"files": [
		"bin/",
		"eslint.config.mjs",
		"fix-headers.json",
		"prettier.json",
		"prettierignore",
		"vitest.config.mjs",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/configs.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/configs/issues"
	},
	"homepage": "https://github.com/CLDMV/configs#readme",
	"keywords": [
		"cldmv",
		"config",
		"configs",
		"shared-config",
		"fix-headers",
		"prettier",
		"eslint",
		"vitest",
		"cli"
	],
	"exports": {
		"./eslint.config.mjs": "./eslint.config.mjs",
		"./fix-headers.json": "./fix-headers.json",
		"./prettier.json": "./prettier.json",
		"./prettierignore": "./prettierignore",
		"./vitest.config.mjs": "./vitest.config.mjs",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@cldmv/eslint-plugin-jsonv": "^1.0.17",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^8.0.3",
		"globals": "^17.14.0"
	},
	"peerDependencies": {
		"@cldmv/prettier-plugin-jsonv": "^1.1.0",
		"eslint": "^10.0.0",
		"vitest": "^4.0.0 || ^5.0.0"
	},
	"peerDependenciesMeta": {
		"@cldmv/prettier-plugin-jsonv": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"scripts": {
		"build:ci": "npm run lint && npm run format:check",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/prettier.config.mjs --write .",
		"format:check": "prettier --config .configs/prettier.config.mjs --check .",
		"fix:headers": "fix-headers --config fix-headers.json",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\""
	},
	"devDependencies": {
		"@cldmv/fix-headers": "^2.2.4",
		"@cldmv/jsonv": "^1.1.5",
		"@cldmv/prettier-plugin-jsonv": "^1.1.4",
		"@cldmv/vitest-runner": "^1.5.6",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.14.0",
		"prettier": "^3.9.9",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
