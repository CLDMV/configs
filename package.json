{
	"name": "@cldmv/configs",
	"version": "1.0.0",
	"description": "CLDMV's shared tool configurations, published as plain JSON files that CLDMV repos extend.",
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"fix-headers.json",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/configs.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/configs/issues"
	},
	"homepage": "https://github.com/CLDMV/configs#readme",
	"keywords": [
		"cldmv",
		"config",
		"configs",
		"shared-config",
		"fix-headers"
	],
	"exports": {
		"./fix-headers.json": "./fix-headers.json",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:ci": "npm run lint && npm run format:check",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"fix:headers": "fix-headers --config fix-headers.json",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\""
	},
	"devDependencies": {
		"@cldmv/eslint-plugin-jsonv": "^1.0.13",
		"@cldmv/fix-headers": "^1.3.12",
		"@cldmv/jsonv": "^1.1.1",
		"@cldmv/prettier-plugin-jsonv": "^1.1.0",
		"@cldmv/vitest-runner": "^1.5.1",
		"@eslint/css": "^2.0.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@vitest/coverage-v8": "^5.0.2",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"vitest": "^5.0.2"
	}
}
